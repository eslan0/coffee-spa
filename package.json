{
  "name": "coffee-spa",
  "version": "0.0.1",
  "type": "module",
  "description": "A compact and fast React frontend for Coffee API.",
  "author": "eliasbrell",
  "repository": {
    "type": "git",
    "url": "https://github.com/Eslan0/coffee-spa"
  },
  "license": "ISC",
  "main": "src/main.tsx",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "alias": "relative-to-alias --src ./src --alias @ --alias-path ./src --extensions ts,tsx --language typescript",
    "format": "prettier --write .",
    "fix-alias": "node scripts/fix-alias.mjs"
  },
  "dependencies": {
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "ts-morph": "^28.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
